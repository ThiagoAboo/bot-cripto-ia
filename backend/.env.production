# Server
PORT=3001
NODE_ENV=production

# Database - PostgreSQL (usando service name do docker-compose)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/botcrypto?schema=public

# JWT
JWT_SECRET=prod-secret-key-change-this-to-a-secure-value
JWT_EXPIRES_IN=24h

# CORS - Frontend via nginx
CORS_ORIGIN=http://localhost

# Logging
LOG_LEVEL=info
TRACE_ENABLED=true
TRACE_RETENTION_DAYS=7
LOG_RETENTION_DAYS=90