generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==============================
// USUÁRIO
// ==============================
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  preferences  String   @default("{}")
  lastLogin    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  configurations  Configuration?
  transactions    Transaction[]
  balances        Balance[]
  logs            Log[]
  traces          Trace[]
  trainingSessions TrainingSession[]
  balanceHistory  BalanceHistory[]
  bots            Bot[]
  botDecisions    BotDecision[]
  botModelArtifacts BotModelArtifact[]
  socialSignalSnapshots SocialSignalSnapshot[]
}

// ==============================
// CONFIGURAÇÕES
// ==============================
model Configuration {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  exchange     String   @default("binance")
  apiKey       String   @default("")
  secretKey    String   @default("")
  
  stopLossPercent      Float  @default(5.0)
  takeProfitPercent    Float  @default(10.0)
  leverage             Int    @default(1)
  maxTradeAmount       Float  @default(1000)
  maxTradeAmountUnit   String @default("USDT")
  
  allowedPairs         String @default("[]")
  
  useBnbForFees        Boolean @default(true)
  discountUsdtPercent  Float  @default(0.075)
  discountBnbPercent   Float  @default(0.075)
  minBnbBalance        Float  @default(0.01)
  reserveBnbForFeesEnabled Boolean @default(true)
  pairDiscovery        String @default("{}")
  
  
  mode                 String @default("spot")
  orderType            String @default("market")
  slippagePercent      Float  @default(0.5)
  
  strategies           String @default("[]")
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==============================
// BOT
// ==============================
model BotTemplate {
  id                String   @id @default(cuid())
  slug              String   @unique
  name              String
  strategyType      String
  indicatorType     String?
  specialization    String?
  description       String?
  defaultParameters String   @default("{}")
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  bots              Bot[]
}

model Bot {
  id               String   @id @default(cuid())
  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId       String?
  template         BotTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  name             String
  strategyType     String
  description      String?
  executionMode    String   @default("paper")
  isSystemManaged  Boolean  @default(true)
  status           String   @default("offline")
  isPaused         Boolean  @default(false)
  focusPair        String?
  currentPair      String?
  lastAnalysis     DateTime?
  recommendedAction String?
  confidence       Float?
  modelVersion     String   @default("v1.0.0")
  modelUrl         String?
  parameters       String   @default("{}")
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  transactions     Transaction[]
  trainingSessions TrainingSession[]
  traces           Trace[]
  decisions        BotDecision[]
  modelArtifacts   BotModelArtifact[]

  @@index([userId])
  @@index([templateId])
}

// ==============================
// TRANSAÇÃO
// ==============================
model Transaction {
  id         String   @id @default(cuid())
  date       DateTime @default(now())
  pair       String
  origin     String
  botId      String?
  bot        Bot?     @relation(fields: [botId], references: [id])
  type       String
  quantity   Float
  requestedQuantity Float @default(0)
  orderType  String  @default("market")
  price      Float
  total      Float
  fee        Float
  feeCurrency String @default("USDT")
  feeRateApplied Float @default(0.001)
  feeDiscountSource String?
  status     String
  externalOrderId String?
  externalClientOrderId String?
  externalStatus String?
  syncedAt   DateTime?
  profitBrl  Float?
  profitPercent Float?
  
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt  DateTime @default(now())

  @@index([userId, externalOrderId])
}

// ==============================
// SALDO
// ==============================
model Balance {
  id         String   @id @default(cuid())
  currency   String
  available  Float
  reserved   Float
  total      Float
  updatedAt  DateTime @updatedAt
  
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, currency])
}

// ==============================
// HISTÓRICO DE SALDO
// ==============================
model BalanceHistory {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  timestamp  DateTime @default(now())
  totalBrl   Float
  
  @@index([userId, timestamp])
}

// ==============================
// SESSÃO DE TREINAMENTO
// ==============================
model TrainingSession {
  id           String   @id @default(cuid())
  botId        String
  bot          Bot      @relation(fields: [botId], references: [id])
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       String   @default("pending")
  startTime    DateTime @default(now())
  endTime      DateTime?
  
  config       String   @default("{}")
  metrics      String   @default("[]")
  bestEpoch    Int?
  bestValLoss  Float?
  modelUrl     String?
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  modelArtifacts BotModelArtifact[]
}

// ==============================
// ARTEFATO DE MODELO DO BOT
// ==============================
model BotModelArtifact {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  botId                String
  bot                  Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  trainingSessionId    String?
  trainingSession      TrainingSession? @relation(fields: [trainingSessionId], references: [id], onDelete: SetNull)
  modelVersion         String
  modelUrl             String
  fingerprint          String
  architecture         String?
  validationStrategy   String?
  forecastHorizonCandles Int?
  governanceRole       String   @default("challenger")
  isActive             Boolean  @default(false)
  notes                String?
  evaluationSummary    String   @default("{}")
  reproducibilitySummary String @default("{}")
  promotedAt           DateTime?
  archivedAt           DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([botId, modelUrl])
  @@index([userId, botId, createdAt])
  @@index([botId, isActive])
}

// ==============================
// DECISÃO / AVALIAÇÃO DO BOT
// ==============================
model BotDecision {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  botId               String
  bot                 Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  pair                String
  action              String
  confidence          Float
  reason              String
  timeframe           String
  executionMode       String
  executionStatus     String
  modelVersion        String?
  modelUrl            String?
  modelArchitecture   String?
  horizonCandles      Int      @default(5)
  buyThresholdPercent Float    @default(0.3)
  sellThresholdPercent Float   @default(-0.3)
  decisionPrice       Float
  requestedQuantity   Float?
  executedQuantity    Float?
  transactionId       String?
  slippagePercent     Float?
  simulatedLatencyMs  Int?
  simulatedFillPercent Float?
  createdAt           DateTime @default(now())
  dueAt               DateTime
  evaluatedAt         DateTime?
  evaluationStatus    String   @default("pending")
  evaluationPrice     Float?
  marketReturnPercent Float?
  strategyReturnPercent Float?
  realizedEdgePercent Float?
  actualLabel         String?
  expectedLabel       String?
  isCorrect           Boolean?

  @@index([userId, botId, createdAt])
  @@index([userId, evaluationStatus, dueAt])
}

// ==============================
// SNAPSHOT DE SINAIS SOCIAIS
// ==============================
model SocialSignalSnapshot {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  configKey   String
  generatedAt DateTime @default(now())
  symbol      String
  pair        String
  score       Float
  mentions    Int
  sentiment   String
  sources     String   @default("[]")
  references  String   @default("[]")
  rank        Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([userId, generatedAt])
  @@index([userId, configKey, generatedAt])
  @@index([userId, pair, generatedAt])
}

// ==============================
// HEARTBEAT DE RUNTIMES EXTERNOS
// ==============================
model RuntimeHeartbeat {
  id          String   @id @default(cuid())
  serviceName String
  instanceId  String
  metadata    String   @default("{}")
  heartbeatAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([serviceName, instanceId])
  @@index([serviceName, heartbeatAt])
}

// ==============================
// LOG
// ==============================
model Log {
  id         String   @id @default(cuid())
  timestamp  DateTime @default(now())
  level      String
  module     String
  message    String
  details    String?
  
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([timestamp])
  @@index([userId])
}

// ==============================
// TRACE
// ==============================
model Trace {
  id                String   @id @default(cuid())
  timestamp         DateTime @default(now())
  level             String
  module            String
  traceId           String
  parentTraceId     String?
  functionName      String
  message           String
  durationMs        Float
  botId             String?
  bot               Bot?     @relation(fields: [botId], references: [id])
  currentPair       String?
  recommendedAction String?
  confidence        Float?
  errorFlag         Boolean  @default(false)
  
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([traceId])
  @@index([timestamp])
  @@index([userId])
}
