# Server
PORT=3001
NODE_ENV=development

# Database - PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/botcrypto?schema=public"

# JWT
JWT_SECRET=dev-secret-key-123456
JWT_EXPIRES_IN=24h

# CORS
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=debug
TRACE_ENABLED=true
TRACE_RETENTION_DAYS=7
LOG_RETENTION_DAYS=90

# Binance
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
BINANCE_BASE_URL=https://api.binance.com
BINANCE_TESTNET=false
BINANCE_TIMEOUT=30000
BINANCE_RECV_WINDOW=5000

# AwesomeAPI
AWESOMEAPI_BASE_URL=https://economia.awesomeapi.com.br
AWESOMEAPI_TIMEOUT=5000

# Webhook
WEBHOOK_URL=
WEBHOOK_ENABLED=false
WEBHOOK_RETRY_ATTEMPTS=3
WEBHOOK_RETRY_DELAY=1000

# Cache
CACHE_TTL_PRICE=5000
CACHE_TTL_RATE=60000
CACHE_TTL_CANDLES=300000
CACHE_TTL_PAIRS=3600000

# Training
TRAINING_MODEL_STORAGE_DIR=./storage/models
TRAINING_UPLOAD_STORAGE_DIR=./storage/uploads
TRAINING_CHECKPOINT_STORAGE_DIR=./storage/checkpoints
TRAINING_WORKER_POLL_MS=250
TRAINING_WORKER_AUTOSTART=true

# Pair discovery / social sources
PAIR_DISCOVERY_CACHE_TTL_MS=300000
PAIR_DISCOVERY_TIMEOUT_MS=12000
PAIR_DISCOVERY_SIGNAL_LIMIT=25
PAIR_DISCOVERY_REDDIT_SUBREDDITS=CryptoCurrency,CryptoMarkets,binance
PAIR_DISCOVERY_REDDIT_LIMIT=25
PAIR_DISCOVERY_RSS_FEEDS=https://cointelegraph.com/rss,https://www.coindesk.com/arc/outboundfeeds/rss/
PAIR_DISCOVERY_X_FEED_URL=
PAIR_DISCOVERY_TELEGRAM_FEED_URL=
