# Server
PORT=3001
NODE_ENV=development

# Database - PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/botcrypto?schema=public"

# JWT
JWT_SECRET=dev-secret-key-123456
JWT_EXPIRES_IN=24h

# CORS
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=debug
TRACE_ENABLED=true
TRACE_RETENTION_DAYS=7
LOG_RETENTION_DAYS=90

# Binance
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
BINANCE_BASE_URL=https://api.binance.com
BINANCE_TESTNET=false
BINANCE_TIMEOUT=30000
BINANCE_RECV_WINDOW=5000

# AwesomeAPI
AWESOMEAPI_BASE_URL=https://economia.awesomeapi.com.br
AWESOMEAPI_TIMEOUT=5000

# Webhook
WEBHOOK_URL=
WEBHOOK_ENABLED=false
WEBHOOK_RETRY_ATTEMPTS=3
WEBHOOK_RETRY_DELAY=1000

# Cache
CACHE_TTL_PRICE=5000
CACHE_TTL_RATE=60000
CACHE_TTL_CANDLES=300000
CACHE_TTL_PAIRS=3600000

# Training
TRAINING_MODEL_STORAGE_DIR=./storage/models
TRAINING_UPLOAD_STORAGE_DIR=./storage/uploads
TRAINING_CHECKPOINT_STORAGE_DIR=./storage/checkpoints
TRAINING_WORKER_POLL_MS=250
TRAINING_WORKER_AUTOSTART=true
TRAINING_ML_ENGINE_PROVIDER=python
PYTHON_ML_EXECUTABLE=python

# Bot worker
BOT_WORKER_POLL_MS=15000
BOT_TRADE_COOLDOWN_MS=300000
BOT_MIN_CONFIDENCE=68
BOT_WORKER_AUTOSTART=true
BOT_PAPER_MIN_EVALUATED_SIGNALS=30
BOT_PAPER_MIN_ACCURACY_PERCENT=55
BOT_PAPER_MIN_AVG_STRATEGY_RETURN_PERCENT=0.15
BOT_PAPER_MIN_AVG_EDGE_PERCENT=0
BOT_PAPER_MAX_CONSECUTIVE_INCORRECT=5
BOT_PAPER_MAX_DRAWDOWN_PERCENT=12
BOT_GOVERNANCE_MODEL_DECISIONS_LIMIT=60
BOT_GOVERNANCE_MIN_ACCURACY_GAIN_PERCENT=1
BOT_GOVERNANCE_MIN_AVG_STRATEGY_RETURN_GAIN_PERCENT=0.05
BOT_GOVERNANCE_MIN_AVG_EDGE_GAIN_PERCENT=0
BOT_GOVERNANCE_MAX_DRAWDOWN_DELTA_PERCENT=2
BOT_GOVERNANCE_AUTO_PROMOTE=false
PAPER_RESET_CURRENCY=USDT
PAPER_RESET_INITIAL_CAPITAL=10000
BINANCE_USER_STREAM_AUTOSTART=true
BINANCE_USER_STREAM_REGISTRY_POLL_MS=30000
BINANCE_USER_STREAM_KEEPALIVE_MS=1500000
BINANCE_USER_STREAM_RECONNECT_BASE_MS=5000
BINANCE_USER_STREAM_RECONNECT_MAX_MS=60000
BINANCE_STREAM_BASE_URL=wss://stream.binance.com:9443/ws

# Pair discovery / social sources
PAIR_DISCOVERY_CACHE_TTL_MS=300000
PAIR_DISCOVERY_TIMEOUT_MS=12000
PAIR_DISCOVERY_SIGNAL_LIMIT=25
PAIR_DISCOVERY_AUTOSYNC_AUTOSTART=true
PAIR_DISCOVERY_AUTOSYNC_POLL_MS=60000
PAIR_DISCOVERY_REDDIT_SUBREDDITS=CryptoCurrency,CryptoMarkets,binance
PAIR_DISCOVERY_REDDIT_LIMIT=25
PAIR_DISCOVERY_RSS_FEEDS=https://cointelegraph.com/rss,https://www.coindesk.com/arc/outboundfeeds/rss/
PAIR_DISCOVERY_X_FEED_URL=
PAIR_DISCOVERY_TELEGRAM_FEED_URL=
